# ---------------------------------------------------------------------------
# MPC VoiceLink LAN — một tiến trình NestJS phục vụ web (apps/web/dist),
# Socket.IO và mediasoup. Điện thoại mở https://<IP-LAN-của-máy-server>.
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=443

# Bắt buộc HTTPS để trình duyệt điện thoại cho dùng microphone.
# Tạo bằng: powershell -ExecutionPolicy Bypass -File .\scripts\new-lan-tls.ps1 -LanIp <ip>
# (đường dẫn tương đối tính từ apps/server)
TLS_CERT_PATH=../../certs/mpc-lan-cert.pem
TLS_KEY_PATH=../../certs/mpc-lan-key.pem

# Thư mục build của web (vite build / vite build --watch) và danh sách channel.
WEB_DIST_PATH=../web/dist
CHANNELS_FILE=channels.json

# Media: mọi WebRtcTransport dùng chung MỘT cổng UDP (+TCP dự phòng).
# Mở firewall cho TCP $PORT và UDP/TCP $MEDIASOUP_PORT.
MEDIASOUP_LISTEN_IP=0.0.0.0
# IP LAN của máy server. Để trống hoặc để IP cũ không còn trên máy thì server tự dò.
MEDIASOUP_ANNOUNCED_ADDRESS=
MEDIASOUP_PORT=44444
MEDIASOUP_ENABLE_UDP=true
MEDIASOUP_ENABLE_TCP=true
# Chỉ cần khi đi qua tunnel cấp cổng công khai khác MEDIASOUP_PORT.
MEDIASOUP_ANNOUNCED_UDP_PORT=
MEDIASOUP_ANNOUNCED_TCP_PORT=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100

# Channel
MAX_MEMBERS_PER_ROOM=15
# Sai PIN quá JOIN_MAX_FAILURES lần trong JOIN_BLOCK_MS sẽ bị chặn theo IP.
JOIN_MAX_FAILURES=8
JOIN_BLOCK_MS=60000

# Floor (quyền nói)
FLOOR_LEASE_MS=2500
HEARTBEAT_INTERVAL_MS=750

# Opus relay profile (benchmark 24000/32000/40000).
OPUS_BITRATE=32000
OPUS_PACKETIZATION_MS=20
MAX_OUTGOING_BITRATE=40000
INPUT_GAIN_DEFAULT=1
INPUT_GAIN_MAX=1.5
OUTPUT_GAIN_DEFAULT=1
OUTPUT_GAIN_MAX=1.5
TARGET_PLAYOUT_DELAY_MS=0
TARGET_PLAYOUT_DELAY_MAX_MS=150

# Mã admin (thu hồi mic, đổi cấu hình âm thanh). Để trống = tắt chức năng admin.
# Không commit giá trị thật.
AUDIO_CONTROL_CODE=
