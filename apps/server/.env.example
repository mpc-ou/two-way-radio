# HTTP and Socket.IO signaling
HOST=0.0.0.0
PORT=3000
# Vite dev server. In LAN production, use the HTTPS web origin instead.
CORS_ORIGINS=http://localhost:5173

# A browser can capture microphone on localhost, but LAN browser clients need
# a trusted HTTPS origin. Set both paths and change PORT (for example 3443)
# before testing microphone/WebRTC across the Hotspot.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Replace before LAN media testing. Never advertise 0.0.0.0 to a remote WebRTC client.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=192.168.43.100
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100

# The MVP join code is shared-room access only; use per-user credentials later.
ROOM_JOIN_CODE=change-this-before-testing
FLOOR_LEASE_MS=2500
HEARTBEAT_INTERVAL_MS=750

# Initial relay profile. These are starting values to benchmark, not quality guarantees.
OPUS_BITRATE=32000
OPUS_PACKETIZATION_MS=20
MAX_OUTGOING_BITRATE=40000

# Server audio policy. Gain is applied in the browser Web Audio graph and is
# capped by this server policy. TARGET_PLAYOUT_DELAY_MS is a target/benchmark
# hint only: browser and OS jitter buffers determine the actual speaker delay.
INPUT_GAIN_DEFAULT=1
INPUT_GAIN_MAX=1.5
OUTPUT_GAIN_DEFAULT=1
OUTPUT_GAIN_MAX=1.5
TARGET_PLAYOUT_DELAY_MS=0
TARGET_PLAYOUT_DELAY_MAX_MS=150

# Optional runtime control for the audio-policy panel. Leave empty to make the
# panel read-only. Do not reuse ROOM_JOIN_CODE and never commit the real value.
AUDIO_CONTROL_CODE=

# HTTP and Socket.IO signaling
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=https://192.168.137.1:5173,https://localhost:5173,*
# Backend runs plain HTTP locally on port 3000; Vite provides HTTPS on 5173
TLS_CERT_PATH=
TLS_KEY_PATH=

# Replace before LAN testing. Never advertise 0.0.0.0 to a remote WebRTC client.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=192.168.137.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100

# The MVP join code is shared-room access only; use per-user credentials later.
ROOM_JOIN_CODE=MPC-VoiceLink-2026-Hoang-8xK4pQ
FLOOR_LEASE_MS=6000
HEARTBEAT_INTERVAL_MS=1000

# Initial relay profile. These are starting values to benchmark, not quality guarantees.
OPUS_BITRATE=32000
OPUS_PACKETIZATION_MS=20
MAX_OUTGOING_BITRATE=40000

